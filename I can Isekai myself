<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test Game</title>
<style>
  body { margin:0; background:black; overflow:hidden; }
  canvas { background:#4ab; display:block; margin:0 auto; }
  #controls { position:absolute; bottom:20px; left:20px; }
  .btn { width:60px; height:60px; border-radius:50%; background:#fff5; border:2px solid white; margin:5px; font-size:20px; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>

<div id="controls">
  <button class="btn" id="up">↑</button><br>
  <button class="btn" id="left">←</button>
  <button class="btn" id="down">↓</button>
  <button class="btn" id="right">→</button>
  <button class="btn" id="act">⚡</button>
</div>

<script>
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");
canvas.width = window.innerWidth;
canvas.height = window.innerHeight;

let player = { x: 100, y: 100, size: 30, hp: 100, weapon: "Infernia", inHouse:false };
let house = { x: 200, y: 200, w:100, h:100 };
let dragon = { x: 400, y: 200, size:50, active:false };
let npc = { x: 300, y: 400, size:30 };
let clockTime = new Date();

function draw() {
  ctx.clearRect(0,0,canvas.width,canvas.height);

  // House
  ctx.fillStyle = "brown";
  ctx.fillRect(house.x, house.y, house.w, house.h);

  // Dragon statue
  ctx.fillStyle = dragon.active ? "gold" : "gray";
  ctx.beginPath();
  ctx.arc(dragon.x, dragon.y, dragon.size, 0, Math.PI*2);
  ctx.fill();

  // NPC
  ctx.fillStyle = "pink";
  ctx.beginPath();
  ctx.arc(npc.x, npc.y, npc.size, 0, Math.PI*2);
  ctx.fill();

  // Player
  ctx.fillStyle = "blue";
  ctx.beginPath();
  ctx.arc(player.x, player.y, player.size, 0, Math.PI*2);
  ctx.fill();

  // UI HP
  ctx.fillStyle = "white";
  ctx.font = "20px Arial";
  ctx.fillText("HP: "+Math.floor(player.hp), 10, 20);
  ctx.fillText("Weapon: "+player.weapon, 10, 40);

  // Real-time clock
  clockTime = new Date();
  ctx.fillText("Time: "+clockTime.toLocaleTimeString(), 10, 60);
}

function update() {
  // Heal if inside house
  if (player.x > house.x && player.x < house.x+house.w &&
      player.y > house.y && player.y < house.y+house.h) {
    player.hp += dragon.active ? 0.5 : 0.2;
    if (player.hp > 100) player.hp = 100;
  }
}

function gameLoop() {
  update();
  draw();
  requestAnimationFrame(gameLoop);
}
gameLoop();

// Controls
document.getElementById("up").ontouchstart = ()=>player.y-=10;
document.getElementById("down").ontouchstart = ()=>player.y+=10;
document.getElementById("left").ontouchstart = ()=>player.x-=10;
document.getElementById("right").ontouchstart = ()=>player.x+=10;
document.getElementById("act").ontouchstart = ()=>{
  let dx = player.x - dragon.x;
  let dy = player.y - dragon.y;
  if (Math.sqrt(dx*dx+dy*dy) < dragon.size+player.size) {
    dragon.active = true;
    alert("Dragon blessing activated! Healing speed boosted!");
  }
  let ndx = player.x - npc.x;
  let ndy = player.y - npc.y;
  if (Math.sqrt(ndx*ndx+ndy*ndy) < npc.size+player.size) {
    alert("NPC says: Hello! Your weapon speaks: '"+randomWeaponLine()+"'");
  }
};

function randomWeaponLine() {
  let lines = [
    "I hunger for battle!",
    "You should train harder.",
    "Let me taste dragon fire!",
    "I sense danger nearby..."
  ];
  return lines[Math.floor(Math.random()*lines.length)];
}
</script>
</body>
</html>
